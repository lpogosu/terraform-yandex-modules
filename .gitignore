# Provider binaries and module cache
.terraform/
.terraform.tfstate.lock.info

# .terraform.lock.hcl is deliberately NOT ignored for the examples: they are root modules,
# and the lock file is what makes `terraform init` reproducible. Regenerate it for every
# platform the team uses with `make lock`.
# A shared module is not a root module, so its lock file only records whatever the last
# person to run `init` there happened to have - it never belongs in git.
modules/*/.terraform.lock.hcl

# Shared plugin cache used by the Makefile targets
.terraform-cache/

# State never belongs in git: it holds bucket secret keys and database passwords in clear text
*.tfstate
*.tfstate.*
*.tfstate.backup

# Real values: cloud_id, folder_id and passwords identify an account
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
!backend.hcl.example

# Saved plans contain the same secrets as state
*.tfplan
plan.out

# Credentials
*.pem
authorized_key.json
sa-key.json
.env

# Tooling
.tflint.d/
.checkov.baseline
crash.log
crash.*.log

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
