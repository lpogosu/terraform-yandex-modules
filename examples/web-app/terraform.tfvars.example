# Copy to terraform.tfvars and fill in with your own IDs.
# terraform.tfvars is git-ignored on purpose: folder and cloud IDs identify a real account.
#
# db_password is intentionally absent from this file. Pass it at apply time instead:
#   TF_VAR_db_password="$(yc lockbox payload get --name shop-db --key password)" terraform apply

cloud_id     = "b1gxxxxxxxxxxxxxxxxx"
folder_id    = "b1gyyyyyyyyyyyyyyyyy"
default_zone = "ru-central1-a"

app_name    = "shop"
domain_name = "shop.example.com"
bucket_name = "shop-uploads-b1gyyyyyyyyyyyyyyyyy"

app_port     = 8080
db_disk_size = 20

# Private addresses of the application instances. Leave empty on the first apply and
# fill in once the instances exist.
app_backend_ips = [
  { zone = "ru-central1-a", ip_address = "10.30.0.11" },
  { zone = "ru-central1-b", ip_address = "10.30.1.11" },
]

labels = {
  managed-by = "terraform"
  example    = "web-app"
  env        = "prod"
}
